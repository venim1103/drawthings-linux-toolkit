{
  "name": "Media AI Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "USERNAME": "vscode",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "runArgs": [
    "--device",
    "nvidia.com/gpu=all",
    "--device",
    "/dev/dxg",
    "--security-opt",
    "label=disable",
    "--mount",
    "type=bind,source=/usr/lib/wsl,target=/usr/lib/wsl,readonly",
    "--env",
    "NVIDIA_VISIBLE_DEVICES=all",
    "--env",
    "NVIDIA_DRIVER_CAPABILITIES=compute,utility",
    "--env",
    "LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/cuda/targets/x86_64-linux/lib"
  ],
  "initializeCommand": "mkdir -p /tmp/devcontainer-certs && (cp /etc/ssl/certs/ZscalerRootCertificate-2048-SHA256.pem /tmp/devcontainer-certs/ZscalerRootCertificate-2048-SHA256.crt 2>/dev/null || touch /tmp/devcontainer-certs/ZscalerRootCertificate-2048-SHA256.crt)",
  "mounts": [
    "source=/tmp/devcontainer-certs/ZscalerRootCertificate-2048-SHA256.crt,target=/usr/local/share/ca-certificates/ZscalerRootCertificate-2048-SHA256.crt,type=bind,readonly"
  ],
  "containerEnv": {
    "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    "CURL_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "DRAWTHINGS_MODEL_DIR": "/workspaces/drawthings-linux-toolkit/dt-models",
    "DRAWTHINGS_REPO_URL": "https://github.com/drawthingsai/draw-things-community.git",
    "DRAWTHINGS_REPO_REF": "9f3f04b7a0729a50384caf58179bed592044d64d",
    "DRAWTHINGS_PREBUILD_RELEASE": "0",
    "DRAWTHINGS_PREBUILD_CLI": "0"
  },
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "args": [
              "-l"
            ]
          }
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}
